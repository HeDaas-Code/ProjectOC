POSTGRES_DB=projectoc
POSTGRES_USER=projectoc
POSTGRES_PASSWORD=projectoc
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Fernet key for encrypted per-workspace AI credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
WORKSPACE_CREDENTIALS_KEY=
DJANGO_DEBUG=1
# Production: replace secrets, set DEBUG=0, explicit hosts and TLS proxy settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0

# Realtime collaboration (development defaults; use independent random values in production)
SYNC_TICKET_SECRET=projectoc-sync-ticket-local-change-me
SYNC_INTERNAL_SECRET=projectoc-sync-local-secret
SYNC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNC_REQUIRE_ORIGIN=0
SYNC_MAX_ROOM_CLIENTS=50
SYNC_MAX_MESSAGES_PER_WINDOW=120
SYNC_REDIS_URL=redis://redis:6379
SYNC_REDIS_PREFIX=projectoc:sync

# Optional Neo4j projection (PostgreSQL remains the source of truth)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=projectoc-local-change-me

# Durable Git/Neo4j outbox worker
OUTBOX_WORKER_INTERVAL=5
OUTBOX_WORKER_BATCH=20
OUTBOX_WORKER_LEASE_SECONDS=120
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900
OUTBOX_MAX_ATTEMPTS=12
