# Copy to the repository root as .env, then fill every required blank value.
# This file contains no usable production credentials.
COMPOSE_PROJECT_NAME=projectoc
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml

POSTGRES_DB=projectoc
POSTGRES_USER=projectoc
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Generate each independently:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=
SYNC_TICKET_SECRET=
SYNC_INTERNAL_SECRET=
# Stable encryption key; retain it with your secure backup configuration.
# python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
WORKSPACE_CREDENTIALS_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=oc.example.internal,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://oc.example.internal
CSRF_TRUSTED_ORIGINS=https://oc.example.internal
SYNC_ALLOWED_ORIGINS=https://oc.example.internal
SYNC_SERVICE_URL=wss://oc.example.internal
SYNC_REQUIRE_ORIGIN=1
SYNC_REDIS_URL=redis://redis:6379
SYNC_REDIS_PREFIX=projectoc:sync
SYNC_MAX_ROOM_CLIENTS=50
TLDRAW_SCHEMA_VERSION=oc-tldraw-2

# Absolute host directory containing fullchain.pem and privkey.pem.
TLS_CERT_DIR=
HTTPS_BIND=127.0.0.1:443
HTTP_BIND=127.0.0.1:80
VITE_TLDRAW_LICENSE_KEY=

# Optional model service. Empty API key selects offline demonstration mode.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OUTBOX_WORKER_INTERVAL=5
OUTBOX_WORKER_BATCH=20
OUTBOX_WORKER_LEASE_SECONDS=120
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900
OUTBOX_MAX_ATTEMPTS=12
